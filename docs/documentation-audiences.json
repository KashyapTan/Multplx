{
  "version": 1,
  "scope": {
    "trackedPatterns": [
      "*.md",
      "*.mdx",
      "*.rst",
      "*.txt",
      "docs/examples/*"
    ],
    "excludedPrefixes": [
      "firstmate/"
    ],
    "description": "Tracked Markdown-like prose, including symlinked aliases, plus copyable documentation examples. The tracked firstmate/ tree is a read-only upstream reference rather than a Multplx documentation owner. Script headers, executable configuration, generated JSON evidence, and legal text keep their existing code/config/legal owners."
  },
  "allowedAudiences": [
    "public-product",
    "operator-current",
    "operator-example",
    "maintainer-architecture",
    "maintainer-verification",
    "agent-runtime"
  ],
  "setupAudiences": [
    "public-product",
    "operator-current",
    "operator-example"
  ],
  "readmeSetupTargets": [
    "docs/configuration.md",
    "docs/tmux-backend.md",
    "docs/herdr-backend.md",
    "docs/cmux-backend.md"
  ],
  "requiredOwnerPointers": [
