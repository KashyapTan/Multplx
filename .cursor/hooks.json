{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./bin/mx-cursor-hook.sh session-start",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "./bin/mx-cursor-hook.sh pre-tool",
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "./bin/mx-cursor-hook.sh subagent-start",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "./bin/mx-cursor-hook.sh stop",
        "timeout": 28800,
        "loop_limit": 200
      }
    ]
  }
}
