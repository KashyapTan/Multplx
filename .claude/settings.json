{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/mx-sessionstart-nudge.sh"
          },
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/AGENTS.md\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/mx-native-observe.sh --provider claude --event reconcile",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/mx-arm-pretool-check.sh --claude"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/mx-cd-pretool-check.sh --claude"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/mx-subagent-pretool-check.sh --claude"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/AGENTS.md\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/mx-native-observe.sh --provider claude --event start",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/AGENTS.md\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/mx-native-observe.sh --provider claude --event result",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/mx-turnend-guard.sh --claude"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/mx-claude-stop-autoarm.sh",
            "asyncRewake": true,
            "timeout": 28800
          }
        ]
      }
    ]
  }
}
